{
  "name": "imagengine",
  "version": "1.0.0",
  "description": "High-performance edge image transformation and optimization proxy for Cloudflare Pages and Workers using Hono, Photon (Wasm), and resvg (Wasm).",
  "license": "MIT",
  "author": "Grisma",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamgrisma/img.git"
  },
  "keywords": [
    "cloudflare-pages",
    "cloudflare-workers",
    "image-optimization",
    "image-processing",
    "wasm",
    "photon",
    "resvg",
    "hono",
    "edge-computing"
  ],
  "type": "module",
  "scripts": {
